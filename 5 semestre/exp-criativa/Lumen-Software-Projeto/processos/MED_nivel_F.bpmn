      <bpmndi:BPMNShape id="BPMNShape_med_l2" bpmnElement="med_l2" isHorizontal="true"><dc:Bounds x="120" y="250" width="2300" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_med_l3" bpmnElement="med_l3" isHorizontal="true"><dc:Bounds x="120" y="400" width="2300" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_med_l4" bpmnElement="med_l4" isHorizontal="true"><dc:Bounds x="120" y="550" width="2300" height="150"/></bpmndi:BPMNShape>
