        <dc:Bounds x="280" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE4_n3_di" bpmnElement="GDE4_n3" isMarkerVisible="true" color:background-color="#FFF3C4" color:border-color="#C99A1B">
