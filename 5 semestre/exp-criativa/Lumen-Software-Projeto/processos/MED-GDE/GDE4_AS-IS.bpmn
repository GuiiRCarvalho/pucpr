<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GDE4" targetNamespace="http://bpmn.io/schema/bpmn" name="GDE 4 - Critérios para avaliação das alternativas (AS-IS)" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_GDE4">
    <bpmn:participant id="GDE4_PoolCli" name="Demandante / Partes Interessadas" processRef="GDE4_ProcCli"/>
    <bpmn:participant id="GDE4_PoolOrg" name="Organização" processRef="GDE4_ProcOrg"/>
    <bpmn:messageFlow id="GDE4_MF0" name="Alternativas de solução" sourceRef="GDE4_cSend" targetRef="GDE4_s"/>
  </bpmn:collaboration>
  <bpmn:process id="GDE4_ProcCli" isExecutable="false">
    <bpmn:startEvent id="GDE4_cStart" name="Alternativas de solução identificadas">
      <bpmn:outgoing>GDE4_SF0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="GDE4_cSend" name="Comunicar alternativas para avaliação">
      <bpmn:incoming>GDE4_SF0</bpmn:incoming>
      <bpmn:outgoing>GDE4_SF1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="GDE4_cEnd" name="Alternativas comunicadas">
      <bpmn:incoming>GDE4_SF1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE4_SF0" sourceRef="GDE4_cStart" targetRef="GDE4_cSend"/>
    <bpmn:sequenceFlow id="GDE4_SF1" sourceRef="GDE4_cSend" targetRef="GDE4_cEnd"/>
  </bpmn:process>
  <bpmn:process id="GDE4_ProcOrg" isExecutable="false">
    <bpmn:documentation>Resultado esperado: GDE 4 (A partir do nível F) Critérios para avaliação das alternativas de solução são definidos.</bpmn:documentation>
    <bpmn:laneSet id="GDE4_LaneSet">
      <bpmn:lane id="GDE4_Lane0" name="Gestão / Responsável pela Decisão">
        <bpmn:flowNodeRef>GDE4_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE4_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE4_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE4_n3_L</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE4_n4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GDE4_Lane1" name="Equipe Técnica">
        <bpmn:flowNodeRef>GDE4_n5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE4_n6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GDE4_s" name="Alternativas de solução recebidas">
      <bpmn:outgoing>GDE4_SF2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="GDE4_s_med"/>
    </bpmn:startEvent>
    <bpmn:task id="GDE4_t1" name="Considerar critérios de avaliação de modo informal">
      <bpmn:incoming>GDE4_SF2</bpmn:incoming>
      <bpmn:incoming>GDE4_SF5</bpmn:incoming>
      <bpmn:outgoing>GDE4_SF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GDE4_n3" name="Critérios acordados com os envolvidos?" gatewayDirection="Diverging">
      <bpmn:incoming>GDE4_SF3</bpmn:incoming>
      <bpmn:outgoing>GDE4_SF4</bpmn:outgoing>
      <bpmn:outgoing>GDE4_SF6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="GDE4_n3_L" name="Rediscutir critérios">
      <bpmn:incoming>GDE4_SF4</bpmn:incoming>
      <bpmn:outgoing>GDE4_SF5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE4_n4" name="Comunicar critérios à equipe verbalmente">
      <bpmn:incoming>GDE4_SF6</bpmn:incoming>
      <bpmn:outgoing>GDE4_SF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE4_n5" name="Tomar ciência dos critérios">
      <bpmn:incoming>GDE4_SF7</bpmn:incoming>
      <bpmn:outgoing>GDE4_SF8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="GDE4_n6" name="Critérios considerados conforme prática atual">
      <bpmn:incoming>GDE4_SF8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE4_SF2" sourceRef="GDE4_s" targetRef="GDE4_t1"/>
    <bpmn:sequenceFlow id="GDE4_SF3" sourceRef="GDE4_t1" targetRef="GDE4_n3"/>
    <bpmn:sequenceFlow id="GDE4_SF4" name="Não" sourceRef="GDE4_n3" targetRef="GDE4_n3_L"/>
    <bpmn:sequenceFlow id="GDE4_SF5" sourceRef="GDE4_n3_L" targetRef="GDE4_t1"/>
    <bpmn:sequenceFlow id="GDE4_SF6" name="Sim" sourceRef="GDE4_n3" targetRef="GDE4_n4"/>
    <bpmn:sequenceFlow id="GDE4_SF7" sourceRef="GDE4_n4" targetRef="GDE4_n5"/>
    <bpmn:sequenceFlow id="GDE4_SF8" sourceRef="GDE4_n5" targetRef="GDE4_n6"/>
    <bpmn:textAnnotation id="GDE4_A_t1"><bpmn:text>GDE 4 — Não definem critérios de modo formal.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="GDE4_A_t1_as0" associationDirection="None" sourceRef="GDE4_t1" targetRef="GDE4_A_t1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_GDE4" name="GDE 4 - Critérios para avaliação das alternativas (AS-IS)">
    <bpmndi:BPMNPlane id="Plane_GDE4" bpmnElement="Collab_GDE4">
