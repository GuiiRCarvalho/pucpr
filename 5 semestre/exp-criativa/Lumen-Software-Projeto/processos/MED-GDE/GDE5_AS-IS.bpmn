      <bpmndi:BPMNShape id="GDE5_n4_L_di" bpmnElement="GDE5_n4_L" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="660" y="850" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE5_n5_di" bpmnElement="GDE5_n5" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="850" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE5_n6_di" bpmnElement="GDE5_n6" color:background-color="#F8C1D0" color:border-color="#C2185B">
