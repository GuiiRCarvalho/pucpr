        <di:waypoint x="280" y="105"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE5_SF1_di" bpmnElement="GDE5_SF1">
        <di:waypoint x="400" y="105"/>
        <di:waypoint x="512" y="105"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE5_SF2_di" bpmnElement="GDE5_SF2">
