      <bpmndi:BPMNShape id="GDE5_cEnd_di" bpmnElement="GDE5_cEnd" color:background-color="#F8C1D0" color:border-color="#C2185B">
        <dc:Bounds x="512" y="87" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="475" y="127" width="110" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE5_s_di" bpmnElement="GDE5_s" color:background-color="#BDEDE6" color:border-color="#2A9D8F">
        <dc:Bounds x="132" y="427" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="95" y="467" width="110" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE5_n2_di" bpmnElement="GDE5_n2" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="280" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE5_t1_di" bpmnElement="GDE5_t1" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="470" y="745" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE5_n4_di" bpmnElement="GDE5_n4" isMarkerVisible="true" color:background-color="#FFF3C4" color:border-color="#C99A1B">
        <dc:Bounds x="695" y="760" width="50" height="50"/>
