        <dc:Bounds x="850" y="850" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE3_n6_di" bpmnElement="GDE3_n6" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
