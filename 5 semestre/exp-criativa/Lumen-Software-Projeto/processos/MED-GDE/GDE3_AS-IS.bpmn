<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GDE3" targetNamespace="http://bpmn.io/schema/bpmn" name="GDE 3 - Identificação das alternativas de solução (AS-IS)" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_GDE3">
    <bpmn:participant id="GDE3_PoolCli" name="Demandante / Partes Interessadas" processRef="GDE3_ProcCli"/>
    <bpmn:participant id="GDE3_PoolOrg" name="Organização" processRef="GDE3_ProcOrg"/>
    <bpmn:messageFlow id="GDE3_MF0" name="Problema ou questão definido(a)" sourceRef="GDE3_cSend" targetRef="GDE3_s"/>
  </bpmn:collaboration>
  <bpmn:process id="GDE3_ProcCli" isExecutable="false">
    <bpmn:startEvent id="GDE3_cStart" name="Problema ou questão definido(a)">
      <bpmn:outgoing>GDE3_SF0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="GDE3_cSend" name="Comunicar problema para busca de soluções">
      <bpmn:incoming>GDE3_SF0</bpmn:incoming>
      <bpmn:outgoing>GDE3_SF1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="GDE3_cEnd" name="Problema comunicado">
      <bpmn:incoming>GDE3_SF1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE3_SF0" sourceRef="GDE3_cStart" targetRef="GDE3_cSend"/>
    <bpmn:sequenceFlow id="GDE3_SF1" sourceRef="GDE3_cSend" targetRef="GDE3_cEnd"/>
  </bpmn:process>
  <bpmn:process id="GDE3_ProcOrg" isExecutable="false">
    <bpmn:documentation>Resultado esperado: GDE 3 (A partir do nível F) Alternativas de solução para o problema ou questão são identificadas e registradas.</bpmn:documentation>
    <bpmn:laneSet id="GDE3_LaneSet">
      <bpmn:lane id="GDE3_Lane0" name="Gestão / Responsável pela Decisão">
        <bpmn:flowNodeRef>GDE3_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE3_n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE3_n6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE3_n7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GDE3_Lane1" name="Equipe Técnica">
        <bpmn:flowNodeRef>GDE3_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE3_n4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE3_n5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE3_n5_L</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GDE3_s" name="Problema definido recebido">
      <bpmn:outgoing>GDE3_SF2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="GDE3_s_med"/>
    </bpmn:startEvent>
    <bpmn:task id="GDE3_n2" name="Solicitar alternativas de solução à equipe">
      <bpmn:incoming>GDE3_SF2</bpmn:incoming>
      <bpmn:outgoing>GDE3_SF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE3_t1" name="Levantar alternativas de solução">
      <bpmn:incoming>GDE3_SF3</bpmn:incoming>
      <bpmn:incoming>GDE3_SF7</bpmn:incoming>
      <bpmn:outgoing>GDE3_SF4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE3_n4" name="Discutir alternativas em equipe de modo informal">
      <bpmn:incoming>GDE3_SF4</bpmn:incoming>
      <bpmn:outgoing>GDE3_SF5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GDE3_n5" name="Alternativas suficientes?" gatewayDirection="Diverging">
      <bpmn:incoming>GDE3_SF5</bpmn:incoming>
      <bpmn:outgoing>GDE3_SF6</bpmn:outgoing>
      <bpmn:outgoing>GDE3_SF8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="GDE3_n5_L" name="Buscar novas alternativas">
      <bpmn:incoming>GDE3_SF6</bpmn:incoming>
      <bpmn:outgoing>GDE3_SF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE3_n6" name="Comunicar alternativas à gestão verbalmente">
      <bpmn:incoming>GDE3_SF8</bpmn:incoming>
      <bpmn:outgoing>GDE3_SF9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="GDE3_n7" name="Alternativas identificadas conforme prática atual">
      <bpmn:incoming>GDE3_SF9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE3_SF2" sourceRef="GDE3_s" targetRef="GDE3_n2"/>
    <bpmn:sequenceFlow id="GDE3_SF3" sourceRef="GDE3_n2" targetRef="GDE3_t1"/>
    <bpmn:sequenceFlow id="GDE3_SF4" sourceRef="GDE3_t1" targetRef="GDE3_n4"/>
    <bpmn:sequenceFlow id="GDE3_SF5" sourceRef="GDE3_n4" targetRef="GDE3_n5"/>
    <bpmn:sequenceFlow id="GDE3_SF6" name="Não" sourceRef="GDE3_n5" targetRef="GDE3_n5_L"/>
    <bpmn:sequenceFlow id="GDE3_SF7" sourceRef="GDE3_n5_L" targetRef="GDE3_t1"/>
    <bpmn:sequenceFlow id="GDE3_SF8" name="Sim" sourceRef="GDE3_n5" targetRef="GDE3_n6"/>
    <bpmn:sequenceFlow id="GDE3_SF9" sourceRef="GDE3_n6" targetRef="GDE3_n7"/>
    <bpmn:textAnnotation id="GDE3_A_n4"><bpmn:text>GDE 3 — As alternativas de solução não são formalizadas, apenas discutidas pela equipe de modo informal.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="GDE3_A_n4_as0" associationDirection="None" sourceRef="GDE3_n4" targetRef="GDE3_A_n4"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_GDE3" name="GDE 3 - Identificação das alternativas de solução (AS-IS)">
    <bpmndi:BPMNPlane id="Plane_GDE3" bpmnElement="Collab_GDE3">
