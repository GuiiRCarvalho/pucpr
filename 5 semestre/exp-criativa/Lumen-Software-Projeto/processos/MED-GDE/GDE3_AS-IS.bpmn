      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE3_PoolOrg_di" bpmnElement="GDE3_PoolOrg" isHorizontal="true" color:background-color="#FFFFFF" color:border-color="#8E8AB5">
