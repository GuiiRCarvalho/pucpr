      <bpmndi:BPMNShape id="GDE3_s_di" bpmnElement="GDE3_s" color:background-color="#BDEDE6" color:border-color="#2A9D8F">
        <dc:Bounds x="132" y="427" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="95" y="467" width="110" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE3_n2_di" bpmnElement="GDE3_n2" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="280" y="405" width="120" height="80"/>
