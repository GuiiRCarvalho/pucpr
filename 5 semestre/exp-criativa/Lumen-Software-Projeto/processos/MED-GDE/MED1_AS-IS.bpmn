<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MED1" targetNamespace="http://bpmn.io/schema/bpmn" name="MED 1 - Objetivos organizacionais de medição e de desempenho (AS-IS)" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_MED1">
    <bpmn:participant id="MED1_PoolCli" name="Direção / Partes Interessadas" processRef="MED1_ProcCli"/>
    <bpmn:participant id="MED1_PoolOrg" name="Organização" processRef="MED1_ProcOrg"/>
    <bpmn:messageFlow id="MED1_MF0" name="Objetivos de negócio e necessidades de informação" sourceRef="MED1_cSend" targetRef="MED1_s"/>
  </bpmn:collaboration>
  <bpmn:process id="MED1_ProcCli" isExecutable="false">
    <bpmn:startEvent id="MED1_cStart" name="Necessidade de informação identificada">
      <bpmn:outgoing>MED1_SF0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="MED1_cSend" name="Comunicar objetivos de negócio e necessidades de informação">
      <bpmn:incoming>MED1_SF0</bpmn:incoming>
      <bpmn:outgoing>MED1_SF1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="MED1_cEnd" name="Necessidades comunicadas">
      <bpmn:incoming>MED1_SF1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MED1_SF0" sourceRef="MED1_cStart" targetRef="MED1_cSend"/>
    <bpmn:sequenceFlow id="MED1_SF1" sourceRef="MED1_cSend" targetRef="MED1_cEnd"/>
  </bpmn:process>
  <bpmn:process id="MED1_ProcOrg" isExecutable="false">
    <bpmn:documentation>Resultado esperado: MED 1 (A partir do nível F) Objetivos organizacionais de medição e de desempenho, derivados dos objetivos de negócio e das necessidades de informação, são definidos e mantidos atualizados.</bpmn:documentation>
    <bpmn:laneSet id="MED1_LaneSet">
      <bpmn:lane id="MED1_Lane0" name="Gestão / Responsável pelas Medições">
        <bpmn:flowNodeRef>MED1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_n3_L</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_n5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_n7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_n7_L</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED1_n8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MED1_Lane1" name="Equipe do Projeto / Serviço">
        <bpmn:flowNodeRef>MED1_n6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="MED1_s" name="Necessidade de informação recebida">
      <bpmn:outgoing>MED1_SF2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED1_s_med"/>
    </bpmn:startEvent>
    <bpmn:task id="MED1_t1" name="Entender objetivos de negócio e necessidades de informação de modo informal">
      <bpmn:incoming>MED1_SF2</bpmn:incoming>
      <bpmn:incoming>MED1_SF5</bpmn:incoming>
      <bpmn:outgoing>MED1_SF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MED1_n3" name="Entendimento considerado suficiente?" gatewayDirection="Diverging">
      <bpmn:incoming>MED1_SF3</bpmn:incoming>
      <bpmn:outgoing>MED1_SF4</bpmn:outgoing>
      <bpmn:outgoing>MED1_SF6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MED1_n3_L" name="Solicitar / prestar esclarecimentos adicionais">
      <bpmn:incoming>MED1_SF4</bpmn:incoming>
      <bpmn:outgoing>MED1_SF5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MED1_t2" name="Definir objetivos de medição e desempenho de modo informal">
      <bpmn:incoming>MED1_SF6</bpmn:incoming>
      <bpmn:incoming>MED1_SF11</bpmn:incoming>
      <bpmn:outgoing>MED1_SF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MED1_n5" name="Repassar objetivos à equipe verbalmente">
      <bpmn:incoming>MED1_SF7</bpmn:incoming>
      <bpmn:outgoing>MED1_SF8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MED1_n6" name="Tomar ciência dos objetivos de medição">
      <bpmn:incoming>MED1_SF8</bpmn:incoming>
      <bpmn:outgoing>MED1_SF9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MED1_n7" name="Objetivos precisam ser atualizados?" gatewayDirection="Diverging">
      <bpmn:incoming>MED1_SF9</bpmn:incoming>
      <bpmn:outgoing>MED1_SF10</bpmn:outgoing>
      <bpmn:outgoing>MED1_SF12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MED1_n7_L" name="Atualizar objetivos de modo pontual">
      <bpmn:incoming>MED1_SF10</bpmn:incoming>
      <bpmn:outgoing>MED1_SF11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="MED1_n8" name="Objetivos definidos conforme prática atual">
      <bpmn:incoming>MED1_SF12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MED1_SF2" sourceRef="MED1_s" targetRef="MED1_t1"/>
    <bpmn:sequenceFlow id="MED1_SF3" sourceRef="MED1_t1" targetRef="MED1_n3"/>
    <bpmn:sequenceFlow id="MED1_SF4" name="Não" sourceRef="MED1_n3" targetRef="MED1_n3_L"/>
    <bpmn:sequenceFlow id="MED1_SF5" sourceRef="MED1_n3_L" targetRef="MED1_t1"/>
    <bpmn:sequenceFlow id="MED1_SF6" name="Sim" sourceRef="MED1_n3" targetRef="MED1_t2"/>
    <bpmn:sequenceFlow id="MED1_SF7" sourceRef="MED1_t2" targetRef="MED1_n5"/>
    <bpmn:sequenceFlow id="MED1_SF8" sourceRef="MED1_n5" targetRef="MED1_n6"/>
    <bpmn:sequenceFlow id="MED1_SF9" sourceRef="MED1_n6" targetRef="MED1_n7"/>
    <bpmn:sequenceFlow id="MED1_SF10" name="Sim" sourceRef="MED1_n7" targetRef="MED1_n7_L"/>
    <bpmn:sequenceFlow id="MED1_SF11" sourceRef="MED1_n7_L" targetRef="MED1_t2"/>
    <bpmn:sequenceFlow id="MED1_SF12" name="Não" sourceRef="MED1_n7" targetRef="MED1_n8"/>
    <bpmn:textAnnotation id="MED1_A_t2"><bpmn:text>MED 1 — Não existe planejamento de análise dos dados de medições formalizado.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="MED1_A_t2_as0" associationDirection="None" sourceRef="MED1_t2" targetRef="MED1_A_t2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_MED1" name="MED 1 - Objetivos organizacionais de medição e de desempenho (AS-IS)">
