<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GDE2" targetNamespace="http://bpmn.io/schema/bpmn" name="GDE 2 - Definição do problema ou questão (AS-IS)" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_GDE2">
    <bpmn:participant id="GDE2_PoolCli" name="Demandante / Partes Interessadas" processRef="GDE2_ProcCli"/>
    <bpmn:participant id="GDE2_PoolOrg" name="Organização" processRef="GDE2_ProcOrg"/>
    <bpmn:messageFlow id="GDE2_MF0" name="Problema ou questão" sourceRef="GDE2_cSend" targetRef="GDE2_s"/>
  </bpmn:collaboration>
  <bpmn:process id="GDE2_ProcCli" isExecutable="false">
    <bpmn:startEvent id="GDE2_cStart" name="Problema ou questão identificado(a)">
      <bpmn:outgoing>GDE2_SF0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="GDE2_cSend" name="Comunicar problema ou questão">
      <bpmn:incoming>GDE2_SF0</bpmn:incoming>
      <bpmn:outgoing>GDE2_SF1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="GDE2_cEnd" name="Problema comunicado">
      <bpmn:incoming>GDE2_SF1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE2_SF0" sourceRef="GDE2_cStart" targetRef="GDE2_cSend"/>
    <bpmn:sequenceFlow id="GDE2_SF1" sourceRef="GDE2_cSend" targetRef="GDE2_cEnd"/>
  </bpmn:process>
  <bpmn:process id="GDE2_ProcOrg" isExecutable="false">
    <bpmn:documentation>Resultado esperado: GDE 2 (A partir do nível F) O problema ou questão a ser objeto de um processo formal de tomada de decisão é definido.</bpmn:documentation>
    <bpmn:laneSet id="GDE2_LaneSet">
      <bpmn:lane id="GDE2_Lane0" name="Gestão / Responsável pela Decisão">
        <bpmn:flowNodeRef>GDE2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE2_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE2_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE2_n3_L</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE2_n4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GDE2_Lane1" name="Equipe Técnica">
        <bpmn:flowNodeRef>GDE2_n5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE2_n6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GDE2_s" name="Problema ou questão recebido(a)">
      <bpmn:outgoing>GDE2_SF2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="GDE2_s_med"/>
    </bpmn:startEvent>
    <bpmn:task id="GDE2_t1" name="Entender problema ou questão sem planejamento prévio">
      <bpmn:incoming>GDE2_SF2</bpmn:incoming>
      <bpmn:incoming>GDE2_SF5</bpmn:incoming>
      <bpmn:outgoing>GDE2_SF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GDE2_n3" name="Entendimento considerado suficiente?" gatewayDirection="Diverging">
      <bpmn:incoming>GDE2_SF3</bpmn:incoming>
      <bpmn:outgoing>GDE2_SF4</bpmn:outgoing>
      <bpmn:outgoing>GDE2_SF6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="GDE2_n3_L" name="Solicitar / prestar esclarecimentos adicionais">
      <bpmn:incoming>GDE2_SF4</bpmn:incoming>
      <bpmn:outgoing>GDE2_SF5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE2_n4" name="Descrever problema ou questão de modo informal">
      <bpmn:incoming>GDE2_SF6</bpmn:incoming>
      <bpmn:outgoing>GDE2_SF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE2_n5" name="Validar descrição verbalmente com a equipe">
      <bpmn:incoming>GDE2_SF7</bpmn:incoming>
      <bpmn:outgoing>GDE2_SF8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="GDE2_n6" name="Problema definido conforme prática atual">
      <bpmn:incoming>GDE2_SF8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE2_SF2" sourceRef="GDE2_s" targetRef="GDE2_t1"/>
    <bpmn:sequenceFlow id="GDE2_SF3" sourceRef="GDE2_t1" targetRef="GDE2_n3"/>
    <bpmn:sequenceFlow id="GDE2_SF4" name="Não" sourceRef="GDE2_n3" targetRef="GDE2_n3_L"/>
    <bpmn:sequenceFlow id="GDE2_SF5" sourceRef="GDE2_n3_L" targetRef="GDE2_t1"/>
    <bpmn:sequenceFlow id="GDE2_SF6" name="Sim" sourceRef="GDE2_n3" targetRef="GDE2_n4"/>
    <bpmn:sequenceFlow id="GDE2_SF7" sourceRef="GDE2_n4" targetRef="GDE2_n5"/>
    <bpmn:sequenceFlow id="GDE2_SF8" sourceRef="GDE2_n5" targetRef="GDE2_n6"/>
    <bpmn:textAnnotation id="GDE2_A_n4"><bpmn:text>GDE 2 — Não é formalizado, os problemas são identificados sem um planejamento anterior e sem definição com os critérios necessários.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="GDE2_A_n4_as0" associationDirection="None" sourceRef="GDE2_n4" targetRef="GDE2_A_n4"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_GDE2" name="GDE 2 - Definição do problema ou questão (AS-IS)">
    <bpmndi:BPMNPlane id="Plane_GDE2" bpmnElement="Collab_GDE2">
      <bpmndi:BPMNShape id="GDE2_PoolCli_di" bpmnElement="GDE2_PoolCli" isHorizontal="true" color:background-color="#FFFFFF" color:border-color="#8E8AB5">
        <dc:Bounds x="30" y="30" width="1180" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_PoolOrg_di" bpmnElement="GDE2_PoolOrg" isHorizontal="true" color:background-color="#FFFFFF" color:border-color="#8E8AB5">
        <dc:Bounds x="30" y="260" width="1180" height="680"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_Lane0_di" bpmnElement="GDE2_Lane0" isHorizontal="true" color:background-color="#F3F7FE" color:border-color="#8E8AB5">
        <dc:Bounds x="60" y="260" width="1150" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_Lane1_di" bpmnElement="GDE2_Lane1" isHorizontal="true" color:background-color="#F3FAF4" color:border-color="#8E8AB5">
        <dc:Bounds x="60" y="600" width="1150" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_cStart_di" bpmnElement="GDE2_cStart" color:background-color="#BDEDE6" color:border-color="#2A9D8F">
        <dc:Bounds x="132" y="87" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="95" y="127" width="110" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
