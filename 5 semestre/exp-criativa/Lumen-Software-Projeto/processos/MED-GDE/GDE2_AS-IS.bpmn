        <dc:Bounds x="280" y="65" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_cEnd_di" bpmnElement="GDE2_cEnd" color:background-color="#F8C1D0" color:border-color="#C2185B">
        <dc:Bounds x="512" y="87" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="475" y="127" width="110" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_s_di" bpmnElement="GDE2_s" color:background-color="#BDEDE6" color:border-color="#2A9D8F">
        <dc:Bounds x="132" y="427" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="95" y="467" width="110" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_t1_di" bpmnElement="GDE2_t1" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="280" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_n3_di" bpmnElement="GDE2_n3" isMarkerVisible="true" color:background-color="#FFF3C4" color:border-color="#C99A1B">
        <dc:Bounds x="505" y="420" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="470" y="376" width="120" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_n3_L_di" bpmnElement="GDE2_n3_L" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="470" y="510" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_n4_di" bpmnElement="GDE2_n4" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="660" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_n5_di" bpmnElement="GDE2_n5" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="850" y="745" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_n6_di" bpmnElement="GDE2_n6" color:background-color="#F8C1D0" color:border-color="#C2185B">
        <dc:Bounds x="1082" y="767" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1045" y="807" width="110" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GDE2_A_n4_di" bpmnElement="GDE2_A_n4" color:background-color="#FDE7E7" color:border-color="#D9534F">
        <dc:Bounds x="635" y="278" width="170" height="106"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="GDE2_SF0_di" bpmnElement="GDE2_SF0">
        <di:waypoint x="168" y="105"/>
        <di:waypoint x="280" y="105"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_SF1_di" bpmnElement="GDE2_SF1">
        <di:waypoint x="400" y="105"/>
        <di:waypoint x="512" y="105"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_SF2_di" bpmnElement="GDE2_SF2">
        <di:waypoint x="168" y="445"/>
        <di:waypoint x="280" y="445"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_SF3_di" bpmnElement="GDE2_SF3">
        <di:waypoint x="400" y="445"/>
        <di:waypoint x="505" y="445"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_SF4_di" bpmnElement="GDE2_SF4">
