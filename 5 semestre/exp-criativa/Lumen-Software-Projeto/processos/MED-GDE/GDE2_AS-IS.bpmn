        <di:waypoint x="1082" y="785"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_A_n4_as0_di" bpmnElement="GDE2_A_n4_as0">
        <di:waypoint x="720" y="384"/>
        <di:waypoint x="720" y="405"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_MF0_di" bpmnElement="GDE2_MF0">
        <di:waypoint x="340" y="145"/>
