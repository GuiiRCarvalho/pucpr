        <bpmndi:BPMNLabel><dc:Bounds x="557" y="423" width="30" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_SF7_di" bpmnElement="GDE2_SF7">
        <di:waypoint x="780" y="445"/>
        <di:waypoint x="815" y="445"/>
        <di:waypoint x="815" y="785"/>
        <di:waypoint x="850" y="785"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="GDE2_SF8_di" bpmnElement="GDE2_SF8">
