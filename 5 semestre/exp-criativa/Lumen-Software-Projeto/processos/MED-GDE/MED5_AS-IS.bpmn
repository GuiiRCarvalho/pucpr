<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MED5" targetNamespace="http://bpmn.io/schema/bpmn" name="MED 5 - Ações corretivas a partir da análise das medidas (AS-IS)" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_MED5">
    <bpmn:participant id="MED5_PoolCli" name="Direção / Partes Interessadas" processRef="MED5_ProcCli"/>
    <bpmn:participant id="MED5_PoolOrg" name="Organização" processRef="MED5_ProcOrg"/>
    <bpmn:messageFlow id="MED5_MF0" name="Desvio de desempenho" sourceRef="MED5_cSend" targetRef="MED5_s"/>
  </bpmn:collaboration>
  <bpmn:process id="MED5_ProcCli" isExecutable="false">
    <bpmn:startEvent id="MED5_cStart" name="Desvio de desempenho percebido">
      <bpmn:outgoing>MED5_SF0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="MED5_cSend" name="Comunicar desvio de desempenho">
      <bpmn:incoming>MED5_SF0</bpmn:incoming>
      <bpmn:outgoing>MED5_SF1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="MED5_cEnd" name="Desvio comunicado">
      <bpmn:incoming>MED5_SF1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MED5_SF0" sourceRef="MED5_cStart" targetRef="MED5_cSend"/>
    <bpmn:sequenceFlow id="MED5_SF1" sourceRef="MED5_cSend" targetRef="MED5_cEnd"/>
  </bpmn:process>
  <bpmn:process id="MED5_ProcOrg" isExecutable="false">
    <bpmn:documentation>Resultado esperado: MED 5 (A partir do nível F) A partir do resultado da análise das medidas, ações corretivas são realizadas visando alcançar os objetivos de desempenho estabelecidos.</bpmn:documentation>
    <bpmn:laneSet id="MED5_LaneSet">
      <bpmn:lane id="MED5_Lane0" name="Gestão / Responsável pelas Medições">
        <bpmn:flowNodeRef>MED5_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n3_E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MED5_Lane1" name="Equipe do Projeto / Serviço">
        <bpmn:flowNodeRef>MED5_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n7_L</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MED5_n8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="MED5_s" name="Desvio de desempenho comunicado">
      <bpmn:outgoing>MED5_SF2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED5_s_med"/>
    </bpmn:startEvent>
    <bpmn:task id="MED5_n2" name="Avaliar desvio sem análise formal das medidas">
      <bpmn:incoming>MED5_SF2</bpmn:incoming>
      <bpmn:outgoing>MED5_SF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MED5_n3" name="Ação corretiva necessária?" gatewayDirection="Diverging">
      <bpmn:incoming>MED5_SF3</bpmn:incoming>
      <bpmn:outgoing>MED5_SF4</bpmn:outgoing>
      <bpmn:outgoing>MED5_SF5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="MED5_n3_E" name="Nenhuma ação realizada">
      <bpmn:incoming>MED5_SF4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="MED5_n4" name="Definir ação corretiva de modo pontual">
      <bpmn:incoming>MED5_SF5</bpmn:incoming>
      <bpmn:outgoing>MED5_SF6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MED5_t1" name="Executar ação corretiva">
      <bpmn:incoming>MED5_SF6</bpmn:incoming>
      <bpmn:incoming>MED5_SF10</bpmn:incoming>
      <bpmn:outgoing>MED5_SF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MED5_n6" name="Verificar resultado da ação informalmente">
      <bpmn:incoming>MED5_SF7</bpmn:incoming>
      <bpmn:outgoing>MED5_SF8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MED5_n7" name="Objetivo de desempenho alcançado?" gatewayDirection="Diverging">
      <bpmn:incoming>MED5_SF8</bpmn:incoming>
      <bpmn:outgoing>MED5_SF9</bpmn:outgoing>
      <bpmn:outgoing>MED5_SF11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MED5_n7_L" name="Ajustar ação corretiva">
      <bpmn:incoming>MED5_SF9</bpmn:incoming>
      <bpmn:outgoing>MED5_SF10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="MED5_n8" name="Ação corretiva concluída conforme prática atual">
      <bpmn:incoming>MED5_SF11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MED5_SF2" sourceRef="MED5_s" targetRef="MED5_n2"/>
    <bpmn:sequenceFlow id="MED5_SF3" sourceRef="MED5_n2" targetRef="MED5_n3"/>
    <bpmn:sequenceFlow id="MED5_SF4" name="Não" sourceRef="MED5_n3" targetRef="MED5_n3_E"/>
    <bpmn:sequenceFlow id="MED5_SF5" name="Sim" sourceRef="MED5_n3" targetRef="MED5_n4"/>
    <bpmn:sequenceFlow id="MED5_SF6" sourceRef="MED5_n4" targetRef="MED5_t1"/>
    <bpmn:sequenceFlow id="MED5_SF7" sourceRef="MED5_t1" targetRef="MED5_n6"/>
    <bpmn:sequenceFlow id="MED5_SF8" sourceRef="MED5_n6" targetRef="MED5_n7"/>
    <bpmn:sequenceFlow id="MED5_SF9" name="Não" sourceRef="MED5_n7" targetRef="MED5_n7_L"/>
    <bpmn:sequenceFlow id="MED5_SF10" sourceRef="MED5_n7_L" targetRef="MED5_t1"/>
    <bpmn:sequenceFlow id="MED5_SF11" name="Sim" sourceRef="MED5_n7" targetRef="MED5_n8"/>
    <bpmn:textAnnotation id="MED5_A_n2"><bpmn:text>MED 5 — Não foi identificado que a empresa faz análise das medidas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="MED5_A_n2_as0" associationDirection="None" sourceRef="MED5_n2" targetRef="MED5_A_n2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_MED5" name="MED 5 - Ações corretivas a partir da análise das medidas (AS-IS)">
