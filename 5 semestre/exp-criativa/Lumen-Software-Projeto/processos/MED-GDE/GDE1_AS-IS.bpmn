<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GDE1" targetNamespace="http://bpmn.io/schema/bpmn" name="GDE 1 - Diretrizes para decisão formal (AS-IS)" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_GDE1">
    <bpmn:participant id="GDE1_PoolCli" name="Demandante / Partes Interessadas" processRef="GDE1_ProcCli"/>
    <bpmn:participant id="GDE1_PoolOrg" name="Organização" processRef="GDE1_ProcOrg"/>
    <bpmn:messageFlow id="GDE1_MF0" name="Necessidade de decisão" sourceRef="GDE1_cSend" targetRef="GDE1_s"/>
  </bpmn:collaboration>
  <bpmn:process id="GDE1_ProcCli" isExecutable="false">
    <bpmn:startEvent id="GDE1_cStart" name="Necessidade de decisão identificada">
      <bpmn:outgoing>GDE1_SF0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="GDE1_cSend" name="Comunicar necessidade de decisão">
      <bpmn:incoming>GDE1_SF0</bpmn:incoming>
      <bpmn:outgoing>GDE1_SF1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="GDE1_cEnd" name="Necessidade comunicada">
      <bpmn:incoming>GDE1_SF1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE1_SF0" sourceRef="GDE1_cStart" targetRef="GDE1_cSend"/>
    <bpmn:sequenceFlow id="GDE1_SF1" sourceRef="GDE1_cSend" targetRef="GDE1_cEnd"/>
  </bpmn:process>
  <bpmn:process id="GDE1_ProcOrg" isExecutable="false">
    <bpmn:documentation>Resultado esperado: GDE 1 (A partir do nível F) Diretrizes definindo quando um processo formal de tomada de decisão, baseado em critérios, deve ser seguido e com a definição de papeis, com autoridade para tomada de decisão, são estabelecidas, mantidas atualizadas e usadas.</bpmn:documentation>
    <bpmn:laneSet id="GDE1_LaneSet">
      <bpmn:lane id="GDE1_Lane0" name="Gestão / Responsável pela Decisão">
        <bpmn:flowNodeRef>GDE1_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE1_n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE1_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE1_n3_E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE1_n4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE1_n5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="GDE1_Lane1" name="Equipe Técnica">
        <bpmn:flowNodeRef>GDE1_n6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GDE1_n7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GDE1_s" name="Necessidade de decisão recebida">
      <bpmn:outgoing>GDE1_SF2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="GDE1_s_med"/>
    </bpmn:startEvent>
    <bpmn:task id="GDE1_n2" name="Avaliar se a questão exige decisão conforme prática atual">
      <bpmn:incoming>GDE1_SF2</bpmn:incoming>
      <bpmn:outgoing>GDE1_SF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GDE1_n3" name="Questão é crítica?" gatewayDirection="Diverging">
      <bpmn:incoming>GDE1_SF3</bpmn:incoming>
      <bpmn:outgoing>GDE1_SF4</bpmn:outgoing>
      <bpmn:outgoing>GDE1_SF5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="GDE1_n3_E" name="Questão tratada sem processo de decisão">
      <bpmn:incoming>GDE1_SF4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="GDE1_n4" name="Definir quem decide de modo informal">
      <bpmn:incoming>GDE1_SF5</bpmn:incoming>
      <bpmn:outgoing>GDE1_SF6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE1_n5" name="Comunicar responsáveis pela decisão">
      <bpmn:incoming>GDE1_SF6</bpmn:incoming>
      <bpmn:outgoing>GDE1_SF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GDE1_n6" name="Tomar ciência do papel na decisão">
      <bpmn:incoming>GDE1_SF7</bpmn:incoming>
      <bpmn:outgoing>GDE1_SF8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="GDE1_n7" name="Papéis definidos conforme prática atual">
      <bpmn:incoming>GDE1_SF8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="GDE1_SF2" sourceRef="GDE1_s" targetRef="GDE1_n2"/>
    <bpmn:sequenceFlow id="GDE1_SF3" sourceRef="GDE1_n2" targetRef="GDE1_n3"/>
    <bpmn:sequenceFlow id="GDE1_SF4" name="Não" sourceRef="GDE1_n3" targetRef="GDE1_n3_E"/>
    <bpmn:sequenceFlow id="GDE1_SF5" name="Sim" sourceRef="GDE1_n3" targetRef="GDE1_n4"/>
    <bpmn:sequenceFlow id="GDE1_SF6" sourceRef="GDE1_n4" targetRef="GDE1_n5"/>
    <bpmn:sequenceFlow id="GDE1_SF7" sourceRef="GDE1_n5" targetRef="GDE1_n6"/>
    <bpmn:sequenceFlow id="GDE1_SF8" sourceRef="GDE1_n6" targetRef="GDE1_n7"/>
    <bpmn:textAnnotation id="GDE1_A_n2"><bpmn:text>GDE 1 — Não foi identificado que a empresa possui definição formal para tomada de decisão.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="GDE1_A_n2_as0" associationDirection="None" sourceRef="GDE1_n2" targetRef="GDE1_A_n2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_GDE1" name="GDE 1 - Diretrizes para decisão formal (AS-IS)">
