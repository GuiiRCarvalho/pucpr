        <dc:Bounds x="850" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MED2_n6_di" bpmnElement="MED2_n6" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
