        <dc:Bounds x="280" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MED2_n3_di" bpmnElement="MED2_n3" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="470" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MED2_n4_di" bpmnElement="MED2_n4" isMarkerVisible="true" color:background-color="#FFF3C4" color:border-color="#C99A1B">
