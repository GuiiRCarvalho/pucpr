        <dc:Bounds x="280" y="405" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MED4_t1_di" bpmnElement="MED4_t1" color:background-color="#CFE2F7" color:border-color="#2F6DB5">
        <dc:Bounds x="470" y="745" width="120" height="80"/>
