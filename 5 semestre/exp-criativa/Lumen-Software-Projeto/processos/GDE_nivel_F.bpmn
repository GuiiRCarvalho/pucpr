      <bpmndi:BPMNShape id="BPMNShape_gde_t3" bpmnElement="gde_t3"><dc:Bounds x="1030" y="285" width="190" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_t4" bpmnElement="gde_t4"><dc:Bounds x="1270" y="435" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_t5" bpmnElement="gde_t5"><dc:Bounds x="1500" y="285" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_t6" bpmnElement="gde_t6"><dc:Bounds x="1730" y="285" width="200" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_g3" bpmnElement="gde_g3"><dc:Bounds x="1970" y="445" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_t7" bpmnElement="gde_t7"><dc:Bounds x="2040" y="585" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_end" bpmnElement="gde_end"><dc:Bounds x="2260" y="307" width="36" height="36"/></bpmndi:BPMNShape>
