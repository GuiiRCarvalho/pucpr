<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_GDE_Nivel_F" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Process_GDE_Nivel_F">
    <bpmn:participant id="participant_Process_GDE_Nivel_F" name="Lumen Software — Gerência de Decisões" processRef="Process_GDE_Nivel_F"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_GDE_Nivel_F" name="Gerência de Decisões - Nível F" isExecutable="false">
    <bpmn:documentation>Modelo BPMN de referência até o nível F, construído sobre as evidências atuais da empresa. O fluxo preserva a entrada informal observada e explicita GDE 1 a GDE 6 para formalização da tomada de decisão.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_GDE_Nivel_F">
      <bpmn:lane id="gde_l1" name="Solicitante / Equipe">
        <bpmn:flowNodeRef>gde_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gde_l2" name="Gestor / Tomador de decisão">
        <bpmn:flowNodeRef>gde_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gde_l3" name="Equipe técnica / Especialistas">
        <bpmn:flowNodeRef>gde_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gde_g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="gde_l4" name="Registro / Comunicação">
        <bpmn:flowNodeRef>gde_t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="gde_start" name="Problema ou decisão crítica identificada">
      <bpmn:outgoing>gde_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gde_g1" name="Decisão requer processo formal?">
      <bpmn:incoming>gde_f1</bpmn:incoming>
      <bpmn:outgoing>gde_f2</bpmn:outgoing>
      <bpmn:outgoing>gde_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gde_t1" name="[GDE 1] Aplicar diretrizes, papéis e autoridade">
      <bpmn:incoming>gde_f2</bpmn:incoming>
      <bpmn:outgoing>gde_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="gde_t2" name="[GDE 2] Definir problema ou questão">
      <bpmn:incoming>gde_f4</bpmn:incoming>
      <bpmn:incoming>gde_f7</bpmn:incoming>
      <bpmn:outgoing>gde_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gde_g2" name="Definição validada?">
      <bpmn:incoming>gde_f5</bpmn:incoming>
      <bpmn:outgoing>gde_f6</bpmn:outgoing>
      <bpmn:outgoing>gde_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gde_t3" name="[GDE 3] Identificar e registrar alternativas">
      <bpmn:incoming>gde_f6</bpmn:incoming>
      <bpmn:incoming>gde_f13</bpmn:incoming>
      <bpmn:outgoing>gde_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="gde_t4" name="[GDE 4] Definir critérios de avaliação">
      <bpmn:incoming>gde_f8</bpmn:incoming>
      <bpmn:outgoing>gde_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="gde_t5" name="[GDE 5] Selecionar método de avaliação">
      <bpmn:incoming>gde_f9</bpmn:incoming>
      <bpmn:outgoing>gde_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="gde_t6" name="[GDE 6] Avaliar alternativas e registrar decisão">
      <bpmn:incoming>gde_f10</bpmn:incoming>
      <bpmn:outgoing>gde_f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gde_g3" name="Alternativa recomendada?">
      <bpmn:incoming>gde_f11</bpmn:incoming>
      <bpmn:outgoing>gde_f12</bpmn:outgoing>
      <bpmn:outgoing>gde_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gde_t7" name="Comunicar decisão e responsáveis">
      <bpmn:incoming>gde_f3</bpmn:incoming>
      <bpmn:incoming>gde_f12</bpmn:incoming>
      <bpmn:outgoing>gde_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="gde_end" name="Decisão registrada">
      <bpmn:incoming>gde_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="gde_f1" name="" sourceRef="gde_start" targetRef="gde_g1">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f2" name="Sim" sourceRef="gde_g1" targetRef="gde_t1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f3" name="Não" sourceRef="gde_g1" targetRef="gde_t7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f4" name="" sourceRef="gde_t1" targetRef="gde_t2">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f5" name="" sourceRef="gde_t2" targetRef="gde_g2">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f6" name="Sim" sourceRef="gde_g2" targetRef="gde_t3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f7" name="Não" sourceRef="gde_g2" targetRef="gde_t2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f8" name="" sourceRef="gde_t3" targetRef="gde_t4">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f9" name="" sourceRef="gde_t4" targetRef="gde_t5">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f10" name="" sourceRef="gde_t5" targetRef="gde_t6">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f11" name="" sourceRef="gde_t6" targetRef="gde_g3">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f12" name="Sim" sourceRef="gde_g3" targetRef="gde_t7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f13" name="Não" sourceRef="gde_g3" targetRef="gde_t3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gde_f14" name="" sourceRef="gde_t7" targetRef="gde_end">
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="gde_note"><bpmn:text>Base atual: a equipe discute problemas e alternativas de modo informal. A planilha registra ausência de diretrizes, critérios, métodos e registros formais; o fluxo abaixo organiza esses pontos até o nível F.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_gde_note" sourceRef="gde_g1" targetRef="gde_note" associationDirection="One"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_GDE_Nivel_F">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_GDE_Nivel_F" bpmnElement="Collaboration_Process_GDE_Nivel_F">
