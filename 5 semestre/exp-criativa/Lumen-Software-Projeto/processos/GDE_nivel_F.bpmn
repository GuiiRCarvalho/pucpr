      <bpmndi:BPMNShape id="BPMNShape_gde_l1" bpmnElement="gde_l1" isHorizontal="true"><dc:Bounds x="120" y="100" width="2300" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_l2" bpmnElement="gde_l2" isHorizontal="true"><dc:Bounds x="120" y="250" width="2300" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gde_l3" bpmnElement="gde_l3" isHorizontal="true"><dc:Bounds x="120" y="400" width="2300" height="150"/></bpmndi:BPMNShape>
