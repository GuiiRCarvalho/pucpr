<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FabriK_REQ" targetNamespace="https://fabrik.example/processos/req">
  <process id="Process_REQ_FabriK" name="Engenharia de Requisitos e Controle de Mudanças" isExecutable="false">
    <laneSet id="LaneSet_REQ">
      <lane id="Lane_Client" name="Cliente">
        <flowNodeRef>Start_Request</flowNodeRef>
        <flowNodeRef>Submit_Request</flowNodeRef>
        <flowNodeRef>Customer_Review</flowNodeRef>
        <flowNodeRef>Gateway_Approved</flowNodeRef>
      </lane>
      <lane id="Lane_GP" name="Gerente de Projeto (GP)">
        <flowNodeRef>Register_Request</flowNodeRef>
        <flowNodeRef>Gateway_Change</flowNodeRef>
        <flowNodeRef>Negotiate</flowNodeRef>
      </lane>
      <lane id="Lane_Analyst" name="Analista de Negócios">
        <flowNodeRef>Impact_Analysis</flowNodeRef>
        <flowNodeRef>Elicit_Specify</flowNodeRef>
        <flowNodeRef>Baseline_Req</flowNodeRef>
      </lane>
      <lane id="Lane_Team" name="Equipe Técnica">
        <flowNodeRef>Review_Commit</flowNodeRef>
        <flowNodeRef>Gateway_Feasible</flowNodeRef>
        <flowNodeRef>Implement</flowNodeRef>
        <flowNodeRef>Correct</flowNodeRef>
        <flowNodeRef>Direct_Request</flowNodeRef>
        <flowNodeRef>Route_To_GP</flowNodeRef>
      </lane>
      <lane id="Lane_QA_GCO" name="QA / GCO">
        <flowNodeRef>Verify_Test</flowNodeRef>
        <flowNodeRef>Gateway_Test</flowNodeRef>
        <flowNodeRef>Release</flowNodeRef>
        <flowNodeRef>End_Release</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Request" name="Demanda recebida"/>
    <userTask id="Submit_Request" name="Formalizar necessidade ou mudança"/>
    <userTask id="Register_Request" name="Registrar solicitação e definir responsável"/>
    <exclusiveGateway id="Gateway_Change" name="Mudança de requisito?" gatewayDirection="Diverging"/>
    <userTask id="Impact_Analysis" name="Analisar impacto da mudança"/>
    <userTask id="Elicit_Specify" name="Elicitar, especificar e priorizar requisitos">
      <documentation>REQ 1 e REQ 2: identificar e confirmar necessidades, expectativas, restrições e interfaces; especificar, priorizar e atualizar requisitos.</documentation>
    </userTask>
    <userTask id="Review_Commit" name="Revisar requisitos, estimar e firmar compromisso">
      <documentation>REQ 3: obter compromisso da equipe técnica com a implementação.</documentation>
    </userTask>
    <exclusiveGateway id="Gateway_Feasible" name="Viável?" gatewayDirection="Diverging"/>
    <userTask id="Negotiate" name="GP + Analista: corrigir inconsistências e negociar escopo">
      <documentation>REQ 5: identificar e corrigir inconsistências entre requisitos, planos e produtos.</documentation>
    </userTask>
    <userTask id="Customer_Review" name="Revisar entendimento e critérios de aceite"/>
    <exclusiveGateway id="Gateway_Approved" name="Aceite do cliente?" gatewayDirection="Diverging"/>
    <userTask id="Baseline_Req" name="Aprovar baseline e atualizar rastreabilidade">
      <documentation>REQ 4: estabelecer e manter rastreabilidade bidirecional entre requisitos e produtos de trabalho.</documentation>
    </userTask>
    <userTask id="Implement" name="Implementar requisitos aprovados na baseline"/>
    <userTask id="Verify_Test" name="Verificar requisitos e testar a versão">
      <documentation>Bloquear liberação se requisitos, testes, versão ou não conformidades críticas não estiverem tratados.</documentation>
    </userTask>
    <exclusiveGateway id="Gateway_Test" name="Passou nos testes?" gatewayDirection="Diverging"/>
    <userTask id="Correct" name="Corrigir inconsistências e defeitos"/>
    <userTask id="Release" name="Controlar baseline e liberar pacote identificado"/>
    <endEvent id="End_Release" name="Pacote de release liberado"/>
    <startEvent id="Direct_Request" name="Solicitação direta recebida"/>
    <userTask id="Route_To_GP" name="Registrar e encaminhar ao GP; não iniciar trabalho"/>
    <sequenceFlow id="F01" sourceRef="Start_Request" targetRef="Submit_Request"/>
    <sequenceFlow id="F02" sourceRef="Submit_Request" targetRef="Register_Request"/>
    <sequenceFlow id="F03" sourceRef="Register_Request" targetRef="Gateway_Change"/>
    <sequenceFlow id="F04" sourceRef="Gateway_Change" targetRef="Impact_Analysis" name="Sim"/>
    <sequenceFlow id="F05" sourceRef="Gateway_Change" targetRef="Elicit_Specify" name="Não"/>
    <sequenceFlow id="F06" sourceRef="Impact_Analysis" targetRef="Elicit_Specify"/>
    <sequenceFlow id="F07" sourceRef="Elicit_Specify" targetRef="Review_Commit"/>
    <sequenceFlow id="F08" sourceRef="Review_Commit" targetRef="Gateway_Feasible"/>
    <sequenceFlow id="F09" sourceRef="Gateway_Feasible" targetRef="Negotiate" name="Não"/>
    <sequenceFlow id="F10" sourceRef="Gateway_Feasible" targetRef="Customer_Review" name="Sim"/>
    <sequenceFlow id="F11" sourceRef="Negotiate" targetRef="Elicit_Specify" name="Revisar"/>
    <sequenceFlow id="F12" sourceRef="Customer_Review" targetRef="Gateway_Approved"/>
    <sequenceFlow id="F13" sourceRef="Gateway_Approved" targetRef="Negotiate" name="Não"/>
    <sequenceFlow id="F14" sourceRef="Gateway_Approved" targetRef="Baseline_Req" name="Sim"/>
    <sequenceFlow id="F15" sourceRef="Baseline_Req" targetRef="Implement"/>
    <sequenceFlow id="F16" sourceRef="Implement" targetRef="Verify_Test"/>
    <sequenceFlow id="F17" sourceRef="Verify_Test" targetRef="Gateway_Test"/>
    <sequenceFlow id="F18" sourceRef="Gateway_Test" targetRef="Correct" name="Não"/>
    <sequenceFlow id="F19" sourceRef="Correct" targetRef="Verify_Test" name="Reverificação"/>
    <sequenceFlow id="F20" sourceRef="Gateway_Test" targetRef="Release" name="Sim"/>
    <sequenceFlow id="F21" sourceRef="Release" targetRef="End_Release"/>
    <sequenceFlow id="F22" sourceRef="Direct_Request" targetRef="Route_To_GP"/>
    <sequenceFlow id="F23" sourceRef="Route_To_GP" targetRef="Register_Request"/>
    <dataObject id="Data_D01" name="Oportunidade/contrato ou pedido de mudança"/>
    <dataObjectReference id="Ref_D01" name="Oportunidade/contrato ou pedido de mudança" dataObjectRef="Data_D01"/>
    <association id="Assoc_D01" sourceRef="Ref_D01" targetRef="Register_Request" associationDirection="One"/>
    <dataObject id="Data_D02" name="Necessidade e restrições do cliente"/>
    <dataObjectReference id="Ref_D02" name="Necessidade e restrições do cliente" dataObjectRef="Data_D02"/>
    <association id="Assoc_D02" sourceRef="Ref_D02" targetRef="Elicit_Specify" associationDirection="One"/>
    <dataObject id="Data_D03" name="Arquitetura e ambientes existentes"/>
    <dataObjectReference id="Ref_D03" name="Arquitetura e ambientes existentes" dataObjectRef="Data_D03"/>
    <association id="Assoc_D03" sourceRef="Ref_D03" targetRef="Review_Commit" associationDirection="One"/>
    <dataObject id="Data_D04" name="Disponibilidade da equipe"/>
    <dataObjectReference id="Ref_D04" name="Disponibilidade da equipe" dataObjectRef="Data_D04"/>
    <association id="Assoc_D04" sourceRef="Ref_D04" targetRef="Review_Commit" associationDirection="One"/>
    <dataObject id="Data_D05" name="Critérios de qualidade e configuração"/>
    <dataObjectReference id="Ref_D05" name="Critérios de qualidade e configuração" dataObjectRef="Data_D05"/>
    <association id="Assoc_D05" sourceRef="Ref_D05" targetRef="Elicit_Specify" associationDirection="One"/>
    <dataObject id="Data_D06" name="Registro de elicitação"/>
    <dataObjectReference id="Ref_D06" name="Registro de elicitação" dataObjectRef="Data_D06"/>
    <association id="Assoc_D06" sourceRef="Elicit_Specify" targetRef="Ref_D06" associationDirection="One"/>
    <dataObject id="Data_D07" name="Aceite do entendimento"/>
    <dataObjectReference id="Ref_D07" name="Aceite do entendimento" dataObjectRef="Data_D07"/>
    <association id="Assoc_D07" sourceRef="Customer_Review" targetRef="Ref_D07" associationDirection="One"/>
    <dataObject id="Data_D08" name="Requisitos versionados"/>
    <dataObjectReference id="Ref_D08" name="Requisitos versionados" dataObjectRef="Data_D08"/>
    <association id="Assoc_D08" sourceRef="Baseline_Req" targetRef="Ref_D08" associationDirection="One"/>
    <dataObject id="Data_D09" name="Histórico de mudanças"/>
    <dataObjectReference id="Ref_D09" name="Histórico de mudanças" dataObjectRef="Data_D09"/>
    <association id="Assoc_D09" sourceRef="Baseline_Req" targetRef="Ref_D09" associationDirection="One"/>
    <dataObject id="Data_D10" name="Ata de revisão"/>
    <dataObjectReference id="Ref_D10" name="Ata de revisão" dataObjectRef="Data_D10"/>
    <association id="Assoc_D10" sourceRef="Review_Commit" targetRef="Ref_D10" associationDirection="One"/>
    <dataObject id="Data_D11" name="Estimativas e compromisso"/>
    <dataObjectReference id="Ref_D11" name="Estimativas e compromisso" dataObjectRef="Data_D11"/>
    <association id="Assoc_D11" sourceRef="Review_Commit" targetRef="Ref_D11" associationDirection="One"/>
    <dataObject id="Data_D12" name="Análise de impacto"/>
    <dataObjectReference id="Ref_D12" name="Análise de impacto" dataObjectRef="Data_D12"/>
    <association id="Assoc_D12" sourceRef="Impact_Analysis" targetRef="Ref_D12" associationDirection="One"/>
    <dataObject id="Data_D13" name="Decisão"/>
    <dataObjectReference id="Ref_D13" name="Decisão" dataObjectRef="Data_D13"/>
    <association id="Assoc_D13" sourceRef="Negotiate" targetRef="Ref_D13" associationDirection="One"/>
    <dataObject id="Data_D14" name="Matriz/links de rastreabilidade"/>
    <dataObjectReference id="Ref_D14" name="Matriz/links de rastreabilidade" dataObjectRef="Data_D14"/>
    <association id="Assoc_D14" sourceRef="Baseline_Req" targetRef="Ref_D14" associationDirection="One"/>
    <dataObject id="Data_D15" name="Baseline"/>
    <dataObjectReference id="Ref_D15" name="Baseline" dataObjectRef="Data_D15"/>
    <association id="Assoc_D15" sourceRef="Baseline_Req" targetRef="Ref_D15" associationDirection="One"/>
    <dataObject id="Data_D16" name="Pendências fechadas"/>
    <dataObjectReference id="Ref_D16" name="Pendências fechadas" dataObjectRef="Data_D16"/>
    <association id="Assoc_D16" sourceRef="Negotiate" targetRef="Ref_D16" associationDirection="One"/>
    <dataObject id="Data_D17" name="Testes, resultados e não conformidades"/>
    <dataObjectReference id="Ref_D17" name="Testes, resultados e não conformidades" dataObjectRef="Data_D17"/>
    <association id="Assoc_D17" sourceRef="Verify_Test" targetRef="Ref_D17" associationDirection="One"/>
    <dataObject id="Data_D18" name="Pacote de release"/>
    <dataObjectReference id="Ref_D18" name="Pacote de release" dataObjectRef="Data_D18"/>
    <association id="Assoc_D18" sourceRef="Release" targetRef="Ref_D18" associationDirection="One"/>
    <textAnnotation id="Annotation_Direct_Request">
      <text>Solicitação que chega diretamente à equipe técnica é registrada e encaminhada ao GP; o trabalho não começa sem aprovação.</text>
    </textAnnotation>
    <association id="Assoc_Direct_Request_Note" sourceRef="Route_To_GP" targetRef="Annotation_Direct_Request" associationDirection="None"/>
  </process>
